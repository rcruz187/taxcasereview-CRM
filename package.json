{
  "name": "tcr-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "check-polling": "node scripts/check-polling-intervals.cjs",
    "manual:style": "node scripts/manual-professionalize.mjs",
    "storage:fix-display": "node scripts/fix-storage-usage-display.mjs",
    "email:state-sync": "node scripts/fix-email-state-sync.mjs",
    "email:count-sync": "node scripts/fix-email-bulk-counts.mjs",
    "dashboard:glow": "node scripts/restore-dashboard-card-glow.mjs",
    "forms:state-esign-prefill": "node scripts/fix-state-esign-prefill.mjs",
    "forms:irs-current": "node scripts/fix-irs-current-field-maps.mjs",
    "reports:accuracy": "node scripts/fix-reporting-accuracy.mjs",
    "accounting:oauth-state": "node scripts/fix-accounting-oauth-state.mjs",
    "ui:quick-create": "node scripts/fix-quick-create-routes.mjs",
    "ui:navigation-audit": "node scripts/audit-ui-navigation.mjs",
    "prebuild": "npm run check-polling && npm run manual:style && npm run storage:fix-display && npm run email:state-sync && npm run email:count-sync && npm run dashboard:glow && npm run forms:state-esign-prefill && npm run forms:irs-current && npm run reports:accuracy && npm run accounting:oauth-state && npm run ui:quick-create && npm run ui:navigation-audit",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@signalwire/js": "^1.5.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
